# =============================================================================
#  Gaming Quiz Battle – configuration du backend
#  Copier ce fichier :
#    - en développement : cp .env.example .env   (à la racine du dépôt)
#    - en production    : /etc/gaming-quiz/gaming-quiz.env (voir docs/installation.md)
#  Ne JAMAIS versionner le fichier contenant les vrais mots de passe.
# =============================================================================

# --- Identité de l'instance --------------------------------------------------
# Nom affiché en bas du site. Si vous ajoutez plus tard d'autres serveurs web,
# c'est la seule valeur qui doit différer entre eux (ex : WEB-01, WEB-02).
INSTANCE_NAME=WEB-01

# --- Serveur HTTP ------------------------------------------------------------
NODE_ENV=development
# Adresse d'écoute d'Express. En production, 127.0.0.1 : seul Nginx y accède.
HOST=127.0.0.1
PORT=3000

# Proxys de confiance pour lire l'IP réelle du client (X-Forwarded-For).
# "loopback,uniquelocal" = Nginx local + éventuel load balancer sur un réseau privé (10.x, 172.16.x, 192.168.x).
TRUST_PROXY=loopback,uniquelocal

# Origines autorisées en CORS (séparées par des virgules). Vide = même origine uniquement
# (cas normal : le frontend et l'API sont servis par le même domaine).
CORS_ORIGINS=

# Niveau de logs : error | warn | info | debug
LOG_LEVEL=info

# Au démarrage, créer automatiquement les tables et insérer les 140 questions
# si la base est vide (true/false). Nécessite le droit de créer des tables.
AUTO_MIGRATE=true

# --- Base de données MySQL 8 ------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gaming_quiz
DB_USER=quiz_app
DB_PASSWORD=change-me
# Nombre max de connexions simultanées par instance
DB_POOL_SIZE=10
# TLS vers MySQL (true/false). Recommandé si la base est sur une autre VM.
DB_SSL=false

# --- Règles du jeu -----------------------------------------------------------
QUESTION_DURATION_MS=15000
# Durée d'affichage de la correction + classement entre deux questions (multijoueur)
REVEAL_DURATION_MS=6000
# Compte à rebours avant la première question (multijoueur)
COUNTDOWN_MS=4000
QUESTIONS_PER_GAME=10
MAX_PLAYERS_PER_GAME=30

# --- Limitation de débit (par adresse IP / par joueur, par instance) --------
# Requêtes /api max par minute et par IP (une classe entière peut partager une IP publique !)
RATE_LIMIT_API_PER_MINUTE=3000
# Création de profils joueurs par IP sur 15 minutes
RATE_LIMIT_PLAYER_CREATE_PER_15MIN=100
# Création/rejoindre une partie, par joueur et par minute
RATE_LIMIT_GAME_ACTIONS_PER_MINUTE=30
# Requêtes de diagnostic (/api/diag/ping) par IP et par minute
RATE_LIMIT_DIAG_PER_MINUTE=600
