# Configuration de compose.full.yml – copier en ".env" dans ce dossier (jamais versionné) :
#   cp full.env.example .env
# Puis remplacer le mot de passe (lettres et chiffres ; ex : openssl rand -hex 24).

# Mot de passe de l'utilisateur MySQL "quiz_app" (OBLIGATOIRE)
DB_PASSWORD=

# Nom affiché en bas du site
INSTANCE_NAME=WEB-01

# Port de la machine sur lequel le site est publié
HTTP_PORT=80
