{
  "name": "@gaming-quiz/backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST stateless de Gaming Quiz Battle (Express + MySQL)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/cli/db.ts migrate",
    "db:seed": "tsx src/cli/db.ts seed",
    "db:setup": "tsx src/cli/db.ts setup",
    "db:status": "tsx src/cli/db.ts status",
    "db:migrate:prod": "node dist/cli/db.js migrate",
    "db:setup:prod": "node dist/cli/db.js setup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
